# PXD Metadata Enhancer Configuration
# Copy this file and customize as needed

pride:
  base_url: "https://www.ebi.ac.uk/pride/ws/archive/v3"
  timeout: 30

pmc:
  # Email (recommended for PMC requests)
  email: null
  # NCBI API key (optional for higher rate limits)
  api_key: null

llm:
  model: "google/gemma-4-31b-it"
  temperature: 0.3
  max_retries: 3
  # API base URL. Leave null to auto-detect: uses OpenRouter
  # (https://openrouter.ai/api/v1) when OPENROUTER_API_KEY is set in the
  # environment, otherwise falls back to calling OpenAI directly with
  # OPENAI_API_KEY. When routed through OpenRouter, `model` above must be an
  # OpenRouter model slug (e.g. "openai/gpt-4o-mini"), not a bare OpenAI name.
  base_url: null

storage:
  base_dir: "./pxd_data"
  cache_pride: true
  cache_pmc: true
  cache_llm: true

relink:
  # Nextflow intermediates only; final ReLink results remain under storage.base_dir.
  work_dir: null

prompts:
  dir: "./prompts"
  # Which prompts to use by default
  enabled:
    - disease_treatment
    - factor_values
    - ms_acquisition
    - organism_sample
    - sample_attributes
    - sample_preparation
    - xlms_conditions
    - xlms_reagents

logging:
  level: "INFO"
  format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
