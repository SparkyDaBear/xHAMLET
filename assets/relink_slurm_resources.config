// ReLink runs locally inside one allocation, not as nested Slurm jobs.
def allocatedCpus = System.getenv('SLURM_CPUS_PER_TASK').toInteger()
// Leave room for the Nextflow JVM and native/container overhead.
def usableMemory = Math.floor(System.getenv('SLURM_MEM_PER_NODE').toLong() * 0.85) as long

params {
    max_cpus = allocatedCpus
    max_memory = "${usableMemory}.MB"
}

executor {
    name = 'local'
    cpus = allocatedCpus
    memory = "${usableMemory}.MB"
    queueSize = 1
}

process {
    executor = 'local'
    resourceLimits = [
        cpus: allocatedCpus,
        memory: "${usableMemory}.MB" as nextflow.util.MemoryUnit
    ]
    withName: 'XISEARCH_LINEAR|XISEARCH_CROSSLINK' {
        cpus = allocatedCpus
        memory = "${usableMemory}.MB"
        // task.memory also covers off-heap allocations and container processes.
        ext.java_heap_gb = { Math.max(1, Math.floor(task.memory.toGiga() * 0.8) as int) }
    }
}
