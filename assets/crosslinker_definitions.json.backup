  },
  "notes": {
    "xi_classes": [
      "SymetricSingleAminoAcidRestrictedCrossLinker - symmetric, single amino acid targets",
      "AsymetricSingleAminoAcidRestrictedCrossLinker - asymmetric with separate first/second specificities",
      "NonCovalentBound - for zero-length, photo-crosslinkers, or non-covalent interactions",
      "LinearCrosslinker - for linear peptide matching without crosslinking"
    ],
    "linked_aminoacids_format": "Comma-separated residues with optional specificity scores in parentheses. E.g., 'K(0),S(0.2),T(0.2),Y(0.2),nterm(0)' where (0) = high specificity, (0.2) = lower. nterm/cterm = termini.",
    "asymmetric_format": "Asymmetric crosslinkers use 'first_linked_aminoacids' and 'second_linked_aminoacids' instead of 'linked_aminoacids'",
    "stubs_format": "Cleavage stubs as 'Residue,Mass' pairs comma-separated. E.g., 'A,54.0105647,S,103.9932001,T,85.9826354'. Only for MS-cleavable crosslinkers."
  }
