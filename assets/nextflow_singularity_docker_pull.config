// Override Singularity container pull to use Docker registry URIs instead of oras://.
//
// The ReLink pipeline modules specify containers as:
//   oras://ghcr.io/bigbio/relink-sif:X.Y.Z  (Singularity, default)
//   ghcr.io/bigbio/relink:X.Y.Z              (Docker / singularity_pull_docker_container)
//
// The oras:// images are not published as OCI artifacts — they are plain Docker
// manifests — so Singularity's oras:// pull fails with:
//   "could not get image manifest, received mediaType:
//    application/vnd.docker.distribution.manifest.v2+json"
//
// Setting singularity_pull_docker_container = true makes Nextflow instruct
// Singularity to pull via docker:// from the Docker registry URI instead.

// Override Singularity container pull to use Docker registry URIs instead of oras://.
//
// The ReLink pipeline modules specify containers as:
//   oras://ghcr.io/bigbio/relink-sif:X.Y.Z  (Singularity, default)
//   ghcr.io/bigbio/relink:X.Y.Z              (Docker / singularity_pull_docker_container)
//
// The oras:// images are not published as OCI artifacts — they are plain Docker
// manifests — so Singularity's oras:// pull fails with:
//   "could not get image manifest, received mediaType:
//    application/vnd.docker.distribution.manifest.v2+json"
//
// Setting singularity_pull_docker_container = true makes Nextflow instruct
// Singularity to pull via docker:// from the Docker registry URI instead.

process {
    ext.singularity_pull_docker_container = true

    // Disable retries for XiSearch crosslink — it runs for days and silently
    // retries up to 3 times (error_retry label in base.config) if killed or
    // if it exits non-zero.  A failure here should be surfaced immediately.
    withName: 'XISEARCH_CROSSLINK' {
        maxRetries    = 0
        errorStrategy = 'finish'
    }
    withName: 'XISEARCH_LINEAR' {
        maxRetries    = 0
        errorStrategy = 'finish'
    }
}

