// Reuse the installed ReLink SIF directly, independently of Nextflow's image cache.
// Other module images still use Docker registry URIs rather than broken ORAS pulls.
def configuredImage = System.getenv('XHAMLET_RELINK_IMAGE')
def localImage = new File(configuredImage ?: "${projectDir}/work/singularity/ghcr.io-bigbio-relink-1.0.0.img")
if (configuredImage && (!localImage.isFile() || !localImage.canRead())) {
    throw new IllegalArgumentException("XHAMLET_RELINK_IMAGE is not a readable image file: ${configuredImage}")
}

process {
    ext.singularity_pull_docker_container = true

    if (localImage.isFile() && localImage.canRead()) {
        withName: 'XISEARCH_LINEAR|XISEARCH_CROSSLINK|MASS_RECALIBRATION|XIFDR|FORMAT_CORRECTION' {
            container = localImage.canonicalPath
        }
    }

    // Disable retries for XiSearch crosslink — it runs for days and silently
    // retries up to 3 times (error_retry label in base.config) if killed or
    // if it exits non-zero.  A failure here should be surfaced immediately.
    withName: 'XISEARCH_CROSSLINK' {
        maxRetries    = 0
        errorStrategy = 'finish'
    }
    withName: 'XISEARCH_LINEAR' {
        maxRetries    = 0
        errorStrategy = 'finish'
    }
}
