  "data": {
    "accession": "PXD064792",
    "title": "Analysis of a BCOR internal tandem duplication in mouse embryonic stem cell to neuronal precursor differentiation",
    "additionalAttributes": [],
    "projectDescription": "To identify vPRC1.1 protein interactions in the context of a mutant BCOR-ITD subunit, we performed cross-linking followed by two-step affinity purification of BioTAP-tagged wildtype BCOR (BCOR-WT) or BCOR-ITD mutant protein in mES cells",
    "sampleProcessingProtocol": "mES cells were grown as monolayer cultures in 50 x 150-mm plates (~3x109 cells) for BioTAP-XL purification. Doxycyline was added (1 μg/mL) to 60 to 70% confluent culture to induce expression of the N-BioTAP–tagged wildtype BCOR or BCOR-ITD mutant cDNA for 24 hr. Steps of cell harvesting, formaldehyde cross-linking, chromatin preparation, affinity purification, input, and IP protein recovery, and data analysis were performed as described in Alekseyenko et al. 2015.",
    "dataProcessingProtocol": "data analysis were performed as described in Alekseyenko et al. 2015.",
