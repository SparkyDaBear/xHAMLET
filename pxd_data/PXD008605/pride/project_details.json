  "data": {
    "accession": "PXD008605",
    "title": "Cryo-EM structure of the full human PRC2 and regulation by AEBP2 and JARID2",
    "additionalAttributes": [],
    "projectDescription": "Structural study of the PRC2 complex and its regulators AEPB2 and JARID2 combining cryo-EM, cross-linking, targeted MS and hydrogen/deuterium exchange MS.",
    "sampleProcessingProtocol": "Chemical cross-linking was performed following previously described procedures (Leitner et al., Nat. Protoc., 2014). Samples were digested using endoproteinase Lys-C and trypsin, digests were fractionated by size-exclusion chromatography and SEC fractions were analyzed by data-dependent LC-MS/MS spectrometry on a Thermo Orbitrap Lumos mass spectrometer. Additional details are provided in the corresponding publication.",
    "dataProcessingProtocol": "MS/MS spectra were searched using xQuest (Walzthoeni et al., Nat. Methods, 2012), version 2.1.5, against the sequences of target proteins and identified contaminants and corresponding decoy sequences. Additional search settings were as follows: Enzyme = trypsin, maximum number of missed cleavages = 2, MS mass tolerance = -15 to +15 ppm, MS/MS mass tolerance = 0.2 Da for “common”-type fragment ions and 0.3 Da for “xlink”-type fragment ions.",
    "projectTags": [
      "Biological"
    ],
