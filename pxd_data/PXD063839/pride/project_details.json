  "data": {
    "accession": "PXD063839",
    "title": "In cellulo cysteine umpolung for protein structure probing: XL LC-MS/MS Data",
    "additionalAttributes": [],
    "projectDescription": "The dataset contains raw data, peakfiles used for the database searches, as well as search results for the crosslinking LC-MS/MS data",
    "sampleProcessingProtocol": "Overexpression and In-Cellulo Crosslinking of GrxC5: After the in-cellulo crosslinking of overexpressed GrxC5 in E. coli cells, the cells were washed and lysed. The protein was purified using a Ni-column and SDS-PAGE, digested on the gel with trypsin, and each of the samples was analyzed via crosslinking LC-MS/MS.\n\nIn-Cellulo Crosslinking with Different Cell Types: Cells were treated with VTT, lysed, and the protein concentration was determined using a BCA assay. The protein digestion was performed according to the SP3 protocol, and the digested samples were analyzed via crosslinking LC–MS/MS",
    "dataProcessingProtocol": "xiSearch v1.8.7 was used for the database search, the FDR filtering was performed with xiFDR v2.3.5.",
    "projectTags": [],
    "keywords": [
