  "data": {
    "accession": "PXD036649",
    "title": "Analysis of bilirubin-induced bovine serum albumin stability using protein denaturation and quantitative cross-linking mass spectrometry",
    "additionalAttributes": [],
    "projectDescription": "We report the combination of protein-denaturation stability principles with quantitative cross-linking mass spectrometry using isobaric quantitative protein interaction reporter technologies.  This method enables the evaluation of ligand-induced protein engagement through analysis of cross-link relative ratios across chemical denaturation.  We found ligand-stabilized cross-linked lysine pairs in bovine serum albumin (BSA) and ligand bilirubin map to known binding sites Sudlow Site I and subdomain IB.",
    "sampleProcessingProtocol": "BSA was incubated with increasing concentrations of urea at room temperature for 10 minutes.  For ligand incubation, BSA-bilirubin was incubated at a 1:1 molar ratio 30 minutes prior to urea addition.  Solutions were subjected to chemical cross-linking with  isobaric quantitative protein interaction reporter using (reporter m/z 808 or 812).   The crosslinking reaction was performed at room temperature for 45 min with constant shaking.  The reaction was quenched upon addition of ammonium bicarbonate for 10 minutes.  Cross-linked BSA solutions were then mixed 1:1 (iqPIR-808:iqPIR-812) (mol:mol) to the native, non-denaturing cross-linked condition.  Mixtures were reduced and alkylated prior to trypsin digestion.   Resulting peptides were desalted and analyzed using a nanoAcquity UPLC system (Waters) coupled to an QE Exactive Plus mass spectrometer (Thermo Scientific).",
    "dataProcessingProtocol": "Data was analyzed with Mango, searched with Comet, and filtered to an estimated false discovery rate of 1% with XLinkProphet.",
    "projectTags": [],
    "keywords": [
      "Quantitative cross-linking",
      "Protein stability",
      "Mass spectrometry"
