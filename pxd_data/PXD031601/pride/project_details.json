  "data": {
    "accession": "PXD031601",
    "title": "APEX2 labeling of Sec bodies in S2 cells",
    "additionalAttributes": [],
    "projectDescription": "APEX2 was tagged to Sec24AB protein in S2 cells. Biotinylation was triggeredin resting cells and amino acid starved cells for comparative analyses of Sec24AB interactome. Sec24AB is localised to Sec bodies during starvation, thereby allowing the identification of protein components in Sec bodies.",
    "sampleProcessingProtocol": "Cells were lysed in non-denaturing conditions for pulldown with streptavidin beads. Biotinylated proteins were digested with Lys C and Trypsin for LC-MS/MS.",
    "dataProcessingProtocol": "Raw data was processed by Maxquant and LFQ comparisons were further filtered by Perseus.",
    "projectTags": [],
    "keywords": [
      "Proximity labeling; biotinylation; apex2; mass spectrometry; sec bodies; granules"
    ],
