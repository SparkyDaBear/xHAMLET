  "data": {
    "accession": "PXD055305",
    "title": "Comparison of MSA with PD/DLB alpha-synuclein pathology using proximity proteomics",
    "additionalAttributes": [],
    "projectDescription": "Multiple systems atrophy (MSA) is a unique synucleinopathy of unknown cause characterized by alpha-synuclein aggregates in oligodendroglia. Here, we used the in-situ proximity labeling technique biotinylation (BAR) by antibody recognition to identify alpha-synuclein interactomes in the MSA brain and compare them with other common synucleinopathies.",
    "sampleProcessingProtocol": "BAR was performed on striatal and midbrain sections from individuals clinically diagnosed with MSA and Parkinson’s disease/dementia with Lewy bodies (PD/DLB). Two BAR targets were used, BAR-PSER129 (asyn aggregates) and BAR-MJFR1 (total asyn). BAR-labeled proteins were purified using streptavidin magnetic bead capture. Captured proteins were embedded into polyacrylamide gels and then digested with trypsin. Tryptic peptides were analyzed/identified using LC-MS/MS (Orbitrap).",
    "dataProcessingProtocol": ".Raw data files were analyzed using both Scaffold/Mascot and Maxquant/Andromeda. Downstream analysis include differential abundance, pathway enrichment, and protein interaction analysis (STRING).",
    "projectTags": [],
    "keywords": [
      "Alpha-synuclein",
      "Interactome"
    ],
