  "data": {
    "accession": "PXD022279",
    "title": "Multiplexed CuAAC-Suzuki-Miyaura for tandem activity-based chemoproteomic profiling",
    "additionalAttributes": [],
    "projectDescription": "Suzuki-Miyauara cross-coupling has been used for mass-spectrometry-based chemoproteomics, including for target deconvolution and site of labeling studies. We also demonstrated that Suzuki-Miyauara cross coupling and CuAAC can be combined for dual target labeling for mass spectrometry-based proteomics. Furthermore, multiplexed CuAAC Suzuki-Miyaura chemoproteomics platform has been successfully applied to identify the protein targets of bifunctional cysteine- and lysine-reactive crosslinking probes.",
    "sampleProcessingProtocol": "The whole datasets including 1) SP3 based Suzuki / CuAAC  based HEK293 T whole lysates labeling, and mass-spectrometry for labeling sites identification; 2) Jurkat cells labeled with chemical probe, chased with cysteine reactive probe, enriched with Suzuki or CuAAC and the chemical probe were detected and identified with data analysis; 3) HEK293 T whole lysates were labelled with both cysteine and lysine probe, followed with CuAAC and Suzuki reactions and the labelled cysteine and lysine can be detected with mass-spectrometry; 4) multiplexed CuAAC Suzuki-Miyaura chemoproteomics to identify crosslinking probe labeling sites in SILAC cell lysates.",
    "dataProcessingProtocol": "The MS2 spectra data were extracted from the raw file using RAW Xtractor (version 1.1.0.22; available at http://fields.scripps.edu/rawconv/). MS2 spectra data were searched using the ProLuCID algorithm (publicly available at http://fields.scripps.edu/yates/wp/?page_id=17 using a reverse concatenated, nonredundant variant of the Human UniProt database (release-2020_01). Cysteine or lysine residues were searched with a static modification for specific chemical probe used in each experiment. Detailed data analysis can be found from the supporting information of the manuscript of “Multiplexed CuAAC-Suzuki-Miyaura for tandem activity-based chemoproteomic profiling”. Peptides were required to have at least one tryptic terminus and to contain the modification. ProLuCID data was filtered through DTASelect (version 2.0) to achieve a peptide false-positive rate below 1%.",
    "projectTags": [],
    "keywords": [
      "Multiplexed cuaac suzuki-miyaura chemoproteomics",
      "Sp3 cleanup",
      "Suzuki-miyauara cross-coupling"
    ],
