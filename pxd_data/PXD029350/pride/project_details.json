  "data": {
    "accession": "PXD029350",
    "title": "Multiplexed isobaric quantitative cross-linking reveals drug-induced interactome changes in breast cancer cells",
    "additionalAttributes": [],
    "projectDescription": "In vivo application of an extended set of six iqPIR reagents (6-plex iqPIR) allowing multiplexed quantitative interactome analysis of up to six biological samples in a single LC-MS acquisition.  Multiplexed iqPIR is demonstrated on MCF-7 breast cancer cells treated with five different Hsp90 inhibitors revealing large scale protein conformational and interaction changes specific to the molecular class of the inhibitors.",
    "sampleProcessingProtocol": "MCF-7 cells were treated with 5 different Hsp90 inhibitors and then cross-linked in vivo with 6-plex iqPIR.",
    "dataProcessingProtocol": "Data analysis was performed with Comet and XLinkProphet.",
