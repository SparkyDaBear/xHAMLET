  "data": {
    "accession": "PXD030543",
    "title": "CTCF ChIP-MS from crosslinked chromatin in mouse embryonic stem cells (mESCs) and motor neurons (MNs)",
    "additionalAttributes": [],
    "projectDescription": "To identify CTCF partners and co-localizing proteins from crosslinked chromatin in mESCs and MNs in endogenous conditions. The goal is to identify proteins within each sample with respect to wild-type control for each.",
    "sampleProcessingProtocol": "One-step FLAG-CTCF pull-down was performed from 3mg cross-linked sonicated chromatin from 2 different cell types (mouse). The pull-down and washes were performed in the presence of protease & phosphatase inhibitors. After washes, competitive elution with 1X FLAG peptide (~0.25 mg/ml) was done. The elutions were in 20mM Tris ph7.9, 0.2mM EDTA, 50mM KCl containing protease & phosphatase inhibitors and ~0.25 mg/ml flag peptide. They were further boiled by adding 0.1% SDS, and 6.6mM DTT for 20 minutes for reversing the cross-linking. The samples were sent to Rutgers Proteomics Facility. They were run on an SDS-PAGE gel, briefly stained with comassie blue, destained followed by reduction with DTT and alkylation with iodoacetomide. Then, the samples were trypsinized in gel, extracted and purified with C18-stage columns. They were then run on an LC-MS/MS in Rutgers Proteomics Facility. MS2 (HCD) were taken in data acquisition mode.",
    "dataProcessingProtocol": "Acquired MS2 spectra were identified with a reverse search algorithm such as SEQUEST or MASCOTT in Rutgers Proteomics Facility. Spectral counts were reported in excel sheets.",
