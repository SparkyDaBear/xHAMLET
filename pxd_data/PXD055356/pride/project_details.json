  "data": {
    "accession": "PXD055356",
    "title": "Cross-linked mass spectrometry for protein-protein interaction with cytotoxin",
    "additionalAttributes": [],
    "projectDescription": "In this study, the membrane target of cytotoxin was identified and determined by cross-linked mass spectrometry. It was found that, annexin A2 appears to be the potential interacting partner of cytotoxin.",
    "sampleProcessingProtocol": "Membrane proteins was extracted from human skin keratinocytes and allowed binding with cytotoxin. A BS3 cross-linker was used to label cytotoxin-membrane proteins prior to western blot excision of bound membrane protein targets. The cytotoxin-bound membrane proteins section were excised and subjected to trypsin digestion before LC-MS/MS.",
    "dataProcessingProtocol": "The raw data files were refined using Thermo ScientificTM Proteome DiscovererTM Software Version 2.5 and the proteins were identified using the UniProt Homo sapiens database (Swiss-prot+TrEMBL, 82,861 entries), with a maximum of two missed cleavages, MS2 tolerance of 0.6 Da, oxidation and acetyl (N-terminal) as variable modifications and carbamidomethyl as fixed modification. All peptides were validated using the percolator® algorithm with a q-value<0.05 false discovery rate (FDR).",
    "projectTags": [],
    "keywords": [
      "Cytotoxin",
      "Annexin a2",
      "Target interaction"
