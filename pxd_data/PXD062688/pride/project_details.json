  "data": {
    "accession": "PXD062688",
    "title": "Fibrin clot proteomics exploring TG2 versus FXIIIA modification of the insoluble fibrin clot",
    "additionalAttributes": [],
    "projectDescription": "This project involved analysis of purified human fibrinogen clots created in vitro.",
    "sampleProcessingProtocol": "Samples were decellularized and washed to remove non-covalent protein interactions using guanidine hydrochloride. Samples were digested with hydroxylamine in the presence of Gnd-HCl and then digested with lys-C and then trypsin using a FASP protocol.",
    "dataProcessingProtocol": "MSFragger was used for a database search and label free quantification using the human SwissProt database. strict trypsin specificity was used with up to 3 mis-cleavage events. The data was rescored using deep learning prediction using MSBooster, PSM validaton was performed and then Percolator was used to filter the peptide results. finally ProteinProphet was used for protin inference and data was filtered at 1% FDR for reports.",
