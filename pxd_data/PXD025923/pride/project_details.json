  "data": {
    "accession": "PXD025923",
    "title": "Human Cell Lines Interactomics Comparison",
    "additionalAttributes": [],
    "projectDescription": "Quantitative comparison of human cell lines (HEK293, HeLa, MCF7) using  acrosslinking mass spectrometry",
    "sampleProcessingProtocol": "Cells were crosslinked in vivo with iaobaric quantitative protein interaction reporter (iqPIR); lysed and mixed pairwise: HEK293/HeLa and MCF7/HeLa. Protein mixtures were reduced, alkylated and digested overnight with trypsin. Peptides were desalted using SepPak c18 columns (Waters) and fractionated on Strong Cation Exchange column. crosslinked peptides were enriched from the fractions using monomeric avidin. Enriched peptide mixtures were separated on a c8 column using liquid chromatography and analyzed with on a Qexactive Plus mass spectrometer (ThermoFisher Scientific) or Velos-FTICR mass spectrometer (ThermoFisher Scientific)",
    "dataProcessingProtocol": "Data was collected in data dependent mode with peptides of charge greater than 4 selected for fragmentation. Qexcative runs were processed with MAngo software for selection of spectra with relationships corresponding to crosslinked peptides and Velos-FTICR data was collected using ReACT method. Data was serched against humna Uniprot database using Comet searhced engine and validated with XLinkProphet. Final data was uploaded to XLinkDB.",
    "projectTags": [],
    "keywords": [
      "Cellular interactome",
      "Quantitative crosslinking",
      "Cell line comparison"
    ],
