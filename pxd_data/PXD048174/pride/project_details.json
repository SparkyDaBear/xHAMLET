  "data": {
    "accession": "PXD048174",
    "title": "Mapping the lipid droplet proteome by using proximity labeling in ccRCC cell lines",
    "additionalAttributes": [],
    "projectDescription": "Comprehensive understanding of the lipid droplet (LD) proteome in ccRCC cells is lacking. In this study, we employed TurboID, an engineered biotin ligase with great efficiency for enzyme-catalyzed proximity labeling, to map the spatial proteome of LDs in ccRCC cells.",
    "sampleProcessingProtocol": "To address proximity labeling of LD membrane, we generated ccRCC cell lines which stably expressing V5-tagged TurboID fused to the C terminal of LD marker protein HILPDA, and the cytoplasmic contrast TurboID fused with NES (nuclear export signal, NES). Next, to map the proteome of LDs, liquid chromatography-tandem mass spectrometry was used to determine identify and quantify proteins isolated by affinity purification from HILPDA and NES cells with adequate biological and technical replicates",
    "dataProcessingProtocol": "The protein identification and quantification was conducted in MaxQuant using lable free mode. Then R was used to do statistic analysis for identify potential LD related proteins.",
    "projectTags": [],
    "keywords": [
      "Lipid droplet",
      "Turboid",
      "Proximity labeling",
      "Clear cell renal cell carcinoma",
      "Hilpda"
