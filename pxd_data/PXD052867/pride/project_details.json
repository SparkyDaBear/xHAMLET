  "data": {
    "accession": "PXD052867",
    "title": "Pull-downs of non-crosslinked or in-cell SDA crosslinked FLAG-AK2-transfected 293 cells",
    "additionalAttributes": [],
    "projectDescription": "Human cells were transfected with a plasmid encoding FLAG-AK2 and subsequently treated with a photoactivatable crosslinker, SDA, or left untreated. Pulldowns were performed from these cells, and the bead-bound material was digested and subjected to LC-MS DIA runs for analysis.",
    "sampleProcessingProtocol": "Human cells were transfected with a plasmid encoding an N-terminally FLAG-tagged AK2. After transfection, the cells were either treated with the crosslinker SDA or left untreated. Pulldowns were performed under both conditions, followed by protein digestion of the bead-bound material. The resulting peptides were then injected into an LC-MS system for DIA runs.",
    "dataProcessingProtocol": "The raw files obtained from the DIA runs were processed using DIA-NN. The resulting files were then utilized for data evaluation and enrichment analysis.",
    "projectTags": [],
    "keywords": [
