  "data": {
    "accession": "PXD040864",
    "title": "Mitochondrial interactome quantitation with dead-end peptides in failing murine heart",
    "additionalAttributes": [],
    "projectDescription": "Dead-end peptide quantitation for improved interpretation of corresponding cross-link abundance differences",
    "sampleProcessingProtocol": "Mice were euthanized by cervical dislocation. The chest cavity was opened, and the heart was rapidly excised and placed into ice-cold, mitochondria isolation medium (MIM: 70mM sucrose, 220mM mannitol, 5mM MOPS, 1.6mM carnitine hydrochloride, 1mM EDTA, 0.025% fatty acid-free BSA, pH 7.4 with 5M KOH) to flesh out blood. The aorta and atria were removed. The myocardium was weighed (heart weight).  See project PXD027757 for more details.",
    "dataProcessingProtocol": "The LC-MS/MS results were analyzed for identification and quantitation of iqPIR crosslinked peptide pairs as previously described (https://doi.org/10.1021/acs.analchem.0c03128). Briefly, LC-MS/MS data raw files were converted to .mzXML format using the ReADW tool in the Trans Proteomic Pipeline software suite (https://www.embopress.org/doi/full/10.1038/msb4100024). Mango (https://pubs.acs.org/doi/10.1021/acs.analchem.7b04991) was used to search for PIR mass relationships and Comet (https://analyticalsciencejournals.onlinelibrary.wiley.com/doi/10.1002/pmic.201200439) was used to search the mzXML files against the mouse Mitocarta 2 database.  See project PXD027757 for more details.",
