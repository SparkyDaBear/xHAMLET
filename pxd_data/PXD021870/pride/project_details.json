  "data": {
    "accession": "PXD021870",
    "title": "Photo-crosslinking of SurA (p-azido-Phe) to unfolded Omps (OmpA and OmpX)",
    "additionalAttributes": [],
    "projectDescription": "To investigate the structural basis of SurA’s chaperone function, we characterized crosslinks between it and two of its clients, OmpA and OmpX, and used those as distance restraints to build structural models.",
    "sampleProcessingProtocol": "We expressed and purified SurA with the photo-crosslinking amino acid, p-azido-Phe, combined it with an unfolded Omp (OmpA or OmpX) in vitro, subjected to UV irradiation for five minutes, digested the photo-products either with trypsin or trypsin/Glu-C in serial, purified peptides, and then injected on a Q-Exactive HFX.",
    "dataProcessingProtocol": "We searched for crosslinked peptides from the raw files using MeroX version 2.0 and filtered to an FDR<1%. See supplementary methods for details. MeroX method files are attached.",
    "projectTags": [],
    "keywords": [
      "Periplasm",
      "Chaperones",
