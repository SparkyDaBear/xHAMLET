    "accession": "PXD018310",
    "title": "Identify Yeast Proteasome Cross-links with Multiple Ion Fragmentation Methods",
    "additionalAttributes": [],
    "projectDescription": "Use of EThcD, CID, HCD and high energy HCD to identify protein cross-links",
    "sampleProcessingProtocol": "The 19S regulatory particle and 20S core particle of the yeast proteasome were isolated by affinity purification and then cross-linked with BS3 and DEST.",
    "dataProcessingProtocol": "RAW files were converted to MGF files using Proteome Discoverer.  An in-house program interpreted mass spectra and then combined results obtained from all four fragmentation methods.",
