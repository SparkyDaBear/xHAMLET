  "data": {
    "accession": "PXD040705",
    "title": "Structure of the Hir histone chaperone complex",
    "additionalAttributes": [],
    "projectDescription": "The evolutionarily conserved HIRA/Hir histone chaperone complex and ASF1/Asf1 co-chaperone cooperate for replication-independent chromatin assembly. Here we report the molecular architecture of the Hir complex with Asf1/H3/H4 via single-particle cryo-EM and crosslinking mass spectrometry.",
    "sampleProcessingProtocol": "Endogenous yeast Hir complex and bacterial expressed Asf1/H3/H4 were purified. Apo-Hir complex and in vitro reconstituted Hir-Asf1/H3/H4 complex using a gradient sedimentation technique were separately crosslinked with disuccinimidyl dibutyric urea (DSBU).",
    "dataProcessingProtocol": "MeroX was utilized with default setting with minor edits described in the method section. Prioritization of K-K pair were done when K miscleavages present and localization score ties.",
    "projectTags": [],
